{
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "pactogg",
    "MaxConnectionPoolSize": 20
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "pactogg:"
  },
  "Jwt": {
    "Issuer": "pactogg",
    "Audience": "pactogg-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Evidence": {
    "AllowedHosts": [
      "youtube.com",
      "youtu.be",
      "twitch.tv",
      "clips.twitch.tv",
      "medal.tv",
      "streamable.com"
    ],
    "MaxImageBytes": 5242880,
    "RetentionDays": 30,
    "MaxPerContract": 3
  },
  "Aws": {
    "Region": "us-east-1",
    "BucketName": "",
    "CloudFrontDomain": ""
  },
  "Features": {
    "VisionOcr": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "CurrentPrivacyVersion": "2026-10-01",
    "MaxGroupsPerUser": 5,
    "InitialPoints": 100,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Moderation": {
    "Mode": "Local",
    "BlockedTerms": [],
    "Image": {
      "MinConfidence": 80,
      "ContentTypeMinConfidence": 70,
      "RelaxedContentTypes": [ "Animated", "Illustrated" ],
      "AlwaysBlocked": [ "Explicit", "Explicit Nudity", "Hate Symbols", "Visually Disturbing", "Self-Harm" ],
      "BlockedUnlessAnimated": [ "Graphic Violence" ]
    }
  },
  "RateLimit": {
    "Enabled": true,
    "DefaultPermitLimit": 120,
    "DefaultWindowSeconds": 60,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "RegisterPermitLimit": 5,
    "RegisterWindowSeconds": 3600,
    "EvidencePermitLimit": 10,
    "EvidenceWindowSeconds": 60
  }
}
