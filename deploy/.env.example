# Copia a deploy/.env y completa con valores reales. Nunca hagas commit de deploy/.env.
DOMAIN=pactogg.example.com
ACME_EMAIL=admin@example.com
API_IMAGE=pactogg-api:latest
REDIS_PASSWORD=change-me-long-random

MongoDb__ConnectionString=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MongoDb__DatabaseName=pactogg
Jwt__SigningKey=replace-with-at-least-32-bytes-of-random-data
Jwt__Issuer=pactogg
Jwt__Audience=pactogg-app
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Auth__CurrentPrivacyVersion=2026-10-01
Moderation__Mode=Aws
Aws__Region=us-east-1
Aws__BucketName=pactogg-evidence-private
Aws__CloudFrontDomain=
Cors__AllowedOrigins__0=https://pactogg.example.com
